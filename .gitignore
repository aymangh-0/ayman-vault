# ── Release binaries ─────────────────────────────────────────────────────────
# Installers are attached to GitHub Releases, never committed to the repository.
*.exe
*.msi
*.zip
*.7z
*.dmg
*.AppImage
*.deb
*.rpm
*.msix
*.appx

# ── Vault data — must never end up in a public repository ────────────────────
*.db
*.sqlite
*.sqlite3
*-wal
*-shm
*.db-journal
*.db.restore
*.db.restore.*
*.bak
*.backup

# ── Secrets and signing material ─────────────────────────────────────────────
.env
.env.*
*.pem
*.pfx
*.p12
*.key
*.crt
*.cer
*.jks
*.keystore
secrets/
credentials/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS and editor noise ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Local agent / tooling files ──────────────────────────────────────────────
.claude/
.codex/

# Note: Markdown documentation and everything under screenshots/ is tracked on
# purpose — no blanket ignore rules are used here.
